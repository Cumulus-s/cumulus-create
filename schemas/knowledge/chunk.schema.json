{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cumulus.local/chunk.schema.json",
  "title": "Chunk",
  "type": "object",
  "required": ["id", "source_id", "node_id", "text", "start_line", "end_line", "token_estimate", "metadata"],
  "properties": {
    "id": { "type": "string" },
    "source_id": { "type": "string" },
    "node_id": { "type": "string" },
    "text": { "type": "string" },
    "start_line": { "type": "integer" },
    "end_line": { "type": "integer" },
    "token_estimate": { "type": "integer" },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}

