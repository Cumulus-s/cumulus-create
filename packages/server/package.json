{
  "name": "@cumulus_cloud/server",
  "version": "0.1.1",
  "description": "Server hooks for Cumulus signups, actions, and safe events.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm --workspace @cumulus_cloud/events run build",
    "test": "vitest run src",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "cumulus",
    "server",
    "agents",
    "actions",
    "observability"
  ],
  "license": "MIT",
  "homepage": "https://cumulush.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cumulus-s/cumulus-create.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cumulus_cloud/events": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
