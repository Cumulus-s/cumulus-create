{
  "name": "@cmls/altocumulus",
  "version": "0.1.0",
  "description": "Local terminal control center for Cumulus projects and usage.",
  "type": "module",
  "bin": {
    "altocumulus": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "python/altocumulus_runtime/__init__.py",
    "python/altocumulus_runtime/scan.py",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "python:test": "python3 -m pytest python/tests",
    "prepublishOnly": "npm run test && npm run python:test && npm run build"
  },
  "dependencies": {
    "@cmls/events": "^0.1.0"
  },
  "keywords": [
    "cumulus",
    "tui",
    "cli",
    "local",
    "scanner"
  ],
  "license": "MIT",
  "homepage": "https://cumulush.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cumulus-s/cumulus-create.git",
    "directory": "packages/altocumulus"
  },
  "bugs": {
    "url": "https://github.com/Cumulus-s/cumulus-create/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
