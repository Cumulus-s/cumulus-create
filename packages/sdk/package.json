{
  "name": "@cls/sdk",
  "version": "0.1.0",
  "description": "Composed Cumulus Auth, DB, and system SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "keywords": [
    "cumulus",
    "auth",
    "database",
    "agents",
    "sdk"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@cls/auth": "^0.1.0",
    "@cls/db": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
