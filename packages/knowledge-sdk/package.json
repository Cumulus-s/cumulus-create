{
  "name": "@cls/knowledge",
  "version": "0.1.0",
  "description": "TypeScript SDK and MCP helpers for Cumulus Knowledge.",
  "type": "module",
  "bin": {
    "cls-knowledge-mcp": "dist/mcp.js",
    "cls-knowledge-api": "dist/api.js",
    "cls-knowledge-setup": "dist/setup.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "postinstall": "node -e \"import('./dist/postinstall.js').catch(() => {})\""
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://cumulush.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cumulus-s/cumulus-create.git",
    "directory": "packages/knowledge-sdk"
  },
  "bugs": {
    "url": "https://github.com/Cumulus-s/cumulus-create/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@cls/events": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.4"
  }
}
