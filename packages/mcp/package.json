{
  "name": "@cmls/mcp",
  "version": "0.1.0",
  "description": "MCP adapter for safe Cumulus agent operations metadata.",
  "type": "module",
  "bin": {
    "cumulus-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@cmls/events": "^0.1.0"
  },
  "license": "MIT",
  "homepage": "https://cumulush.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cumulus-s/cumulus-create.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/Cumulus-s/cumulus-create/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
